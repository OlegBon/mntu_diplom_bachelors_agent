# Diamant ID: лише локальна розробка. Не комітуйте заповнений .env.
# Згенеруйте окремий SECRET_KEY для кожного середовища, наприклад:
# .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-unique-local-secret

# Local MVP only: access JWT lives 8 hours. Allowed range is 15–720 minutes.
# Before production, replace it with short access tokens and refresh sessions.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Один із двох варіантів підключення. DATABASE_URL має пріоритет.
# Local MariaDB: застосунок працює з трьома databases — diamond_oltp,
# diamond_market і diamond_analytics. DB_NAME задає лише default database
# одного URL (залишайте diamond_oltp); DB_USER повинен мати права на всі три.
# Future PostgreSQL/cloud: один DATABASE_URL до однієї physical database з
# трьома schemas з тими самими назвами. Це ще не налаштований runtime.
# DATABASE_URL=mysql+mysqlconnector://user:password@localhost:3306/diamond_oltp
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=diamond_oltp

# Необов'язково: приватне локальне сховище медіа звітів.
# Без цієї змінної використовується ./storage/reports (ігнорується Git).
# MEDIA_STORAGE_PATH=D:\diamant-id-storage\reports

# Потрібні лише для руйнівного scripts/seed_db.py.
# Задайте окремі локальні паролі; вони хешуються bcrypt перед записом у БД.
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
SEED_GEMOLOGIST_PASSWORD=replace-with-local-gemologist-password
