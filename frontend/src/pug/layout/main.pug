doctype html
html(lang="uk")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Diamant ID
        link(rel="stylesheet" href="css/main.css")
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet")

    body
        header.main-header
            .container
                .header-content
                    a.logo(href="/" aria-label="Diamant ID — головна")
                        span.logo-mark(aria-hidden="true")
                            svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true")
                                path(d="M4 8.5 8.5 4h7L20 8.5 12 20 4 8.5Z")
                                path(d="m4 8.5 8 11.5L20 8.5M8.5 4 12 8.5 15.5 4M4 8.5h16")
                        span.logo-text Diamant ID

                    nav#main-nav.main-nav(aria-label="Основна навігація")
                        ul#nav-list
                            li: a(href="/") Головна
                            li: a(href="#public-passport") Перевірити паспорт

                    .header-right
                        .header-auth#auth-block
                        button#burger-btn.burger-btn(type="button" aria-label="Відкрити меню" aria-expanded="false")
                            span
                            span
                            span

        main.page-content
            .container
                block content

        footer.main-footer
            .container
                .footer-content
                    p.footer-copyright
                        | &copy; 
                        span#copyright-year 2026
                        | &nbsp;
                        a.footer-brand(href="/") Diamant ID
                    .footer-links
                        a(href="#") Політика конфіденційності
                        span.separator |
                        a(href="#") Документація

        script(type="module" src="js/main.js")
