extends ../layout/main

block content
    .account-page(hidden data-protected-page="true" data-admin-users-page)
        .page-header
            div
                h1.page-title(data-i18n="experts.title") Експерти
                p.page-subtitle(data-i18n="experts.subtitle") Створюйте облікові записи, змінюйте ролі та безпечно деактивуйте доступ.
        p#admin-users-status.account-status(role="status" aria-live="polite" hidden)
        .account-grid
            section.account-surface
                h2(data-i18n="experts.new") Новий експерт
                form#admin-user-create-form
                    .form-row
                        .form-group.half
                            label(for="new-expert-username" data-i18n="experts.username") Username
                            input#new-expert-username.form-control(type="text" name="username" minlength="3" maxlength="50" pattern="[A-Za-z0-9_.-]+" required)
                        .form-group.half
                            label(for="new-expert-role" data-i18n="experts.role") Роль
                            select#new-expert-role.form-select(name="role")
                                option(value="gemologist" data-i18n="auth.gemologist") Експерт
                                option(value="admin" data-i18n="auth.administrator") Адміністратор
                    .form-group
                        label(for="new-expert-password" data-i18n="experts.temporaryPassword") Тимчасовий пароль
                        input#new-expert-password.form-control(type="password" name="password" minlength="8" autocomplete="new-password" required)
                    .form-row
                        .form-group.half
                            label(for="new-expert-first" data-i18n="profile.firstName") Ім’я
                            input#new-expert-first.form-control(type="text" name="first_name" maxlength="50")
                        .form-group.half
                            label(for="new-expert-last" data-i18n="profile.lastName") Прізвище
                            input#new-expert-last.form-control(type="text" name="last_name" maxlength="50")
                    .form-group
                        label(for="new-expert-middle" data-i18n="profile.middleName") По батькові
                        input#new-expert-middle.form-control(type="text" name="middle_name" maxlength="50")
                    .form-actions
                        button.btn.btn-primary(type="submit" data-i18n="experts.create") Створити експерта
            section.account-surface.account-surface--wide
                h2(data-i18n="experts.accounts") Облікові записи
                p.account-help(data-i18n="experts.accountsHelp") Деактивація не видаляє звіти, паспорти або історію змін. Власний обліковий запис деактивувати не можна.
                .search-group.account-search
                    label.sr-only(for="admin-users-search" data-i18n="experts.search") Пошук облікових записів
                    input#admin-users-search.form-control(type="search" data-i18n-placeholder="experts.searchPlaceholder" placeholder="Пошук за username або ім’ям" autocomplete="off")
                .table-container(tabindex="0")
                    table.data-table.admin-users-table
                        thead
                            tr
                                th(data-i18n="experts.username") Username
                                th(data-i18n="experts.name") Ім’я
                                th(data-i18n="experts.role") Роль
                                th(data-i18n="experts.state") Стан
                                th(data-i18n="experts.actions") Дії
                        tbody#admin-users-body
                nav#admin-users-pagination.pagination(data-i18n-aria-label="experts.pagination" aria-label="Пагінація облікових записів" hidden)
        dialog#admin-user-dialog.account-dialog(aria-labelledby="admin-user-dialog-title")
            form#admin-user-edit-form(method="dialog")
                .account-dialog__header
                    h2#admin-user-dialog-title(data-i18n="experts.editAccount") Редагувати обліковий запис
                    button#admin-user-dialog-close.account-dialog__close(type="button" data-i18n-aria-label="experts.close" aria-label="Закрити") ×
                input#edit-user-id(type="hidden" name="expert_id")
                .form-group
                    label(for="edit-user-username" data-i18n="experts.username") Username
                    input#edit-user-username.form-control(type="text" name="username" minlength="3" maxlength="50" pattern="[A-Za-z0-9_.-]+" required)
                .form-row
                    .form-group.half
                        label(for="edit-user-first" data-i18n="profile.firstName") Ім’я
                        input#edit-user-first.form-control(type="text" name="first_name" maxlength="50")
                    .form-group.half
                        label(for="edit-user-last" data-i18n="profile.lastName") Прізвище
                        input#edit-user-last.form-control(type="text" name="last_name" maxlength="50")
                .form-group
                    label(for="edit-user-middle" data-i18n="profile.middleName") По батькові
                    input#edit-user-middle.form-control(type="text" name="middle_name" maxlength="50")
                .form-group
                    label(for="edit-user-role" data-i18n="experts.role") Роль
                    select#edit-user-role.form-select(name="role")
                        option(value="gemologist" data-i18n="auth.gemologist") Експерт
                        option(value="admin" data-i18n="auth.administrator") Адміністратор
                .form-group
                    label(for="edit-user-password" data-i18n="experts.newTemporaryPassword") Новий тимчасовий пароль
                    input#edit-user-password.form-control(type="password" name="password" minlength="8" autocomplete="new-password")
                    small.form-help(data-i18n="experts.passwordHelp") Залиште порожнім, якщо пароль не потрібно змінювати.
                .account-dialog__actions
                    button#edit-user-save.btn.btn-primary(type="submit" data-i18n="experts.save") Зберегти зміни
                    button#edit-user-activation.btn.btn-outline(type="button")
