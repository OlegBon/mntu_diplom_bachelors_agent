extends ../layout/main

block content
    .account-page(hidden data-protected-page="true" data-reference-catalog-page)
        .page-header
            div
                h1.page-title Довідники
                p.page-subtitle Поточні значення, які сервер надає формам звітів.
        p#reference-catalog-status.account-status(role="status" aria-live="polite" hidden)
        section.account-surface.account-surface--wide
            p.account-help Редагування з причиною, документом-джерелом і версіями для нових звітів заплановане окремою задачею 105. Поточні дані лише для перегляду.
            .table-container(tabindex="0")
                table.data-table
                    thead
                        tr
                            th Категорія
                            th Код
                            th Назва
                    tbody#reference-catalog-body
