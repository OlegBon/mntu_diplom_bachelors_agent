extends ../layout/main

block content
    .dashboard-page.account-page.demo-scope(hidden data-protected-page="true" data-demo-reports)
        .page-header
            div
                h1.page-title Демо
                p.page-subtitle Ізольований synthetic dataset для внутрішньої демонстрації інтерфейсу та технічних моделей.
        .analytics-tabs(role="tablist" aria-label="Розділи demo dataset")
            button.analytics-tabs__tab.is-active(type="button" role="tab" aria-selected="true" aria-controls="demo-reports-panel" id="demo-tab-reports" data-demo-tab="reports") Демо-звіти
            button.analytics-tabs__tab(type="button" role="tab" aria-selected="false" aria-controls="demo-stones-panel" id="demo-tab-stones" data-demo-tab="stones") Камені
            button.analytics-tabs__tab(type="button" role="tab" aria-selected="false" aria-controls="demo-experts-panel" id="demo-tab-experts" data-demo-tab="experts") Експерти
            button.analytics-tabs__tab(type="button" role="tab" aria-selected="false" aria-controls="demo-narratives-panel" id="demo-tab-narratives" data-demo-tab="narratives") Тексти
            button.analytics-tabs__tab(type="button" role="tab" aria-selected="false" aria-controls="demo-quality-panel" id="demo-tab-quality" data-demo-tab="quality") Операції та якість
            button.analytics-tabs__tab(type="button" role="tab" aria-selected="false" aria-controls="demo-administrators-panel" id="demo-tab-administrators" data-demo-tab="administrators") Адміністратори
            button.analytics-tabs__tab(type="button" role="tab" aria-selected="false" aria-controls="demo-providers-panel" id="demo-tab-providers" data-demo-tab="providers") Провайдери
            button.analytics-tabs__tab(type="button" role="tab" aria-selected="false" aria-controls="demo-currency-panel" id="demo-tab-currency" data-demo-tab="currency") Валютні джерела
        #demo-reports-panel(role="tabpanel" aria-labelledby="demo-tab-reports")
            p.demo-scope__notice(role="note")
                strong DEMO · SYNTHETIC DATA
                |  Ізольований внутрішній набір: не експертні, ринкові, продажні чи транзакційні дані.
            section.demo-scope__showcase(aria-label="Показовий demo-звіт")
                div
                    strong Показовий private preview
                    p DEMO-00999 містить синтетичні вкладення та внутрішній PDF без public ID, URL або QR-коду.
                a.btn.btn-outline.btn--compact(href="/demo-report-detail.html?id=DEMO-00999") Відкрити DEMO-00999
            .filters-container
                .filters-bar
                    .search-group
                        label.sr-only(for="demo-report-search") Пошук за номером demo-звіту
                        input#demo-report-search(type="search" placeholder="Пошук за номером звіту" autocomplete="off")
                    button#demo-toggle-filters.btn.btn-primary(type="button" aria-expanded="false" aria-controls="demo-advanced-filters") Фільтри
                    .filter-control.filter-control--quick
                        label.sr-only(for="demo-quick-report-status") Статус звіту
                        select#demo-quick-report-status.form-select
                            option(value="") Усі статуси звіту
                            option(value="issued") Видано
                    .filter-control.filter-control--quick
                        label.sr-only(for="demo-quick-market-status") Статус продажу
                        select#demo-quick-market-status.form-select
                            option(value="") Усі статуси продажу
                            option(value="not_for_sale") Не продається
                    .filter-control.filter-control--quick
                        label.sr-only(for="demo-expert-filter") Експерт
                        select#demo-expert-filter.form-select(disabled title="Synthetic experts буде додано задачею 164")
                            option Усі експерти — незабаром
                #demo-advanced-filters.advanced-filters
                    form#demo-dashboard-filters.filters-grid
                        .filter-item
                            label(for="demo-shape-filter") Форма (Shape)
                            select#demo-shape-filter.form-select(name="shape")
                                option(value="") Будь-яка
                                option(value="Round") Round
                                option(value="Princess") Princess
                                option(value="Oval") Oval
                                option(value="Emerald") Emerald
                                option(value="Cushion") Cushion
                                option(value="Radiant") Radiant
                                option(value="Pear") Pear
                                option(value="Heart") Heart
                                option(value="Marquise") Marquise
                                option(value="Asscher") Asscher
                        .filter-item
                            label Вага (Carat)
                            .range-inputs
                                input#demo-carat-min.form-control(type="number" name="carat_min" min="0" step="0.01" placeholder="Від")
                                input#demo-carat-max.form-control(type="number" name="carat_max" min="0" step="0.01" placeholder="До")
                        .filter-item
                            label(for="demo-color-filter") Колір (Color)
                            select#demo-color-filter.form-select(name="color_grade")
                                option(value="") Будь-який
                        .filter-item
                            label(for="demo-clarity-filter") Чистота (Clarity)
                            select#demo-clarity-filter.form-select(name="clarity_grade")
                                option(value="") Будь-яка
                        .filter-item
                            label(for="demo-cut-filter") Якість (Cut)
                            select#demo-cut-filter.form-select(name="cut_grade")
                                option(value="") Будь-яка
                        .filter-item
                            label Довідковий орієнтир (USD)
                            .range-inputs
                                input#demo-price-min.form-control(type="number" name="price_min" min="0" step="0.01" placeholder="Від")
                                input#demo-price-max.form-control(type="number" name="price_max" min="0" step="0.01" placeholder="До")
                        .filter-item
                            label(for="demo-date-from") Дата створення: від
                            input#demo-date-from.form-control(type="date" name="date_from")
                        .filter-item
                            label(for="demo-date-to") Дата створення: до
                            input#demo-date-to.form-control(type="date" name="date_to")
                        .filter-actions
                            button.btn.btn-primary.btn-sm(type="submit") Застосувати
                            button.btn.btn-outline.btn-sm(type="reset") Очистити
            #demo-dashboard-status.dashboard-status(role="status" aria-live="polite")
            p#demo-dataset-meta.dashboard-demo-note Завантаження набору…
            p.dashboard-demo-note DEMO · SYNTHETIC DATA. Не є експертними, ринковими, продажними чи транзакційними даними.
            .table-container(tabindex="0")
                table.data-table
                    thead: tr
                        th: button.table-sort(type="button" data-demo-sort-key="report_id" aria-label="Сортувати за ID звіту") ID звіту
                        th: button.table-sort(type="button" data-demo-sort-key="report_date" aria-label="Сортувати за датою") Дата
                        th: button.table-sort(type="button" data-demo-sort-key="shape" aria-label="Сортувати за формою") Форма
                        th: button.table-sort(type="button" data-demo-sort-key="carat" aria-label="Сортувати за вагою") Вага (ct)
                        th: button.table-sort(type="button" data-demo-sort-key="color" aria-label="Сортувати за кольором") Колір
                        th: button.table-sort(type="button" data-demo-sort-key="clarity" aria-label="Сортувати за чистотою") Чистота
                        th: button.table-sort(type="button" data-demo-sort-key="cut" aria-label="Сортувати за Cut") Cut
                        th: button.table-sort(type="button" data-demo-sort-key="price" aria-label="Сортувати за demo-орієнтиром") Ціна (USD)
                        th: button.table-sort(type="button" data-demo-sort-key="report_status" aria-label="Сортувати за статусом звіту") Статус звіту
                        th: button.table-sort(type="button" data-demo-sort-key="market_status" aria-label="Сортувати за статусом продажу") Статус продажу
                        th Дії
                    tbody#demo-reports-body
                        tr: td(colspan="11") Завантаження…
            nav#demo-pagination.pagination(aria-label="Пагінація demo-звітів")
        #demo-workflow-controls.demo-time-slice(hidden aria-label="Зріз аналітичних даних")
            form#demo-workflow-slice.analytics-period-filter
                .form-group
                    label(for="demo-workflow-date-from") Від
                    input#demo-workflow-date-from(type="date" name="date_from")
                .form-group
                    label(for="demo-workflow-date-to") До
                    input#demo-workflow-date-to(type="date" name="date_to")
                .analytics-period-filter__actions
                    button.btn.btn-primary(type="submit") Застосувати період
                    button.btn.btn-outline(type="reset") За весь час
            p#demo-workflow-period-summary.analytics-period-summary(role="status" aria-live="polite") Поточний зріз: за весь доступний час.
            p#demo-workflow-period-help.account-help Дані за весь доступний період. У demo зрізі події та тривалості формуються детерміновано; вони не є active-time, review-cycle, SLA чи оцінкою реальних людей.
        section#demo-currency-panel.account-surface.analytics-panel(hidden role="tabpanel" aria-labelledby="demo-tab-currency")
            h2 Валютні джерела
            p.account-help Окремий read-only огляд офіційних USD/UAH знімків НБУ. Валютний курс не є орієнтиром каменю, не входить до synthetic SOM і не змішується з Demo Market A/B.
            p.demo-scope__notice(role="note")
                strong ВАЛЮТНЕ ДЖЕРЕЛО · НБУ
                |  Показано лише зафіксовані FX-знімки. Їхня дата й час отримання зберігаються окремо від demo-набору та від ринкових орієнтирів.
            #demo-currency-status.dashboard-status(role="status" aria-live="polite")
            #demo-currency-results(aria-live="polite")
        section#demo-experts-panel.account-surface.analytics-panel(hidden role="tabpanel" aria-labelledby="demo-tab-experts")
            h2 Synthetic експерти та звіти
            p.account-help Показано synthetic workflow за вибраний період. Actors не є обліковими записами, а всі demo-звіти мають виданий synthetic lifecycle.
            p.demo-scope__notice(role="note")
                strong DEMO · SYNTHETIC WORKFLOW
                |  Це лише технічний зріз вигаданих ролей і відтворюваних інтервалів. Він не вимірює продуктивність, якість, SLA або рейтинг реальних людей.
            #demo-experts-status.dashboard-status(role="status" aria-live="polite")
            #demo-experts-results(aria-live="polite")
        section#demo-narratives-panel.account-surface.analytics-panel(hidden role="tabpanel" aria-labelledby="demo-tab-narratives")
            h2 Synthetic текстові поля
            p.account-help Лише metadata synthetic demo-набору: без оцінювання, норми, рейтингу чи висновку про реального експерта. Самі тексти й уривки не показуються.
            p.demo-scope__notice(role="note")
                strong DEMO · SYNTHETIC TEXTS
                |  Поточні synthetic значення беруться з demo-звітів у зрізі; коментарі подій — лише з synthetic lifecycle events у зрізі.
            #demo-narratives-status.dashboard-status(role="status" aria-live="polite")
            #demo-narratives-results(aria-live="polite")
        section#demo-quality-panel.account-surface.analytics-panel(hidden role="tabpanel" aria-labelledby="demo-tab-quality")
            h2 Synthetic операції та повнота даних
            p.account-help Лише агреговані deterministic workflow facts і покриття synthetic полів. Це не оцінка реальних людей, не рейтинг якості текстів і не public tracking.
            p.demo-scope__notice(role="note")
                strong DEMO · SYNTHETIC OPERATIONS
                |  Використовується той самий ізольований dataset і зріз дат. Private storage, public passports, QR, PDF та відвідувачі не моделюються.
            #demo-quality-status.dashboard-status(role="status" aria-live="polite")
            #demo-quality-results(aria-live="polite")
        section#demo-administrators-panel.account-surface.analytics-panel(hidden role="tabpanel" aria-labelledby="demo-tab-administrators")
            h2 Synthetic перевірки адміністраторів
            p.account-help Тривалість — відтворюваний synthetic інтервал перевірки, а не вимір фактичного активного часу людини.
            p.demo-scope__notice(role="note")
                strong DEMO · SYNTHETIC WORKFLOW
                |  Використовується той самий зріз дат, що й для synthetic експертів; дані не пов’язані з обліковими записами адміністратора.
            #demo-administrators-status.dashboard-status(role="status" aria-live="polite")
            #demo-administrators-results(aria-live="polite")
        section#demo-providers-panel.account-surface.analytics-panel(hidden role="tabpanel" aria-labelledby="demo-tab-providers")
            h2 Synthetic провайдери та орієнтири
            p.account-help Окремий read-only зріз лише для вигаданих Demo Market A/B і synthetic demo-звітів у вибраному періоді.
            p.demo-scope__notice(role="note")
                strong DEMO · SYNTHETIC PROVIDERS
                |  Це coverage і provenance demonstration values, не ринкові джерела, не ціна продажу та не порівняння якості провайдерів.
            #demo-providers-status.dashboard-status(role="status" aria-live="polite")
            #demo-providers-results(aria-live="polite")
        section#demo-stones-panel.account-surface.analytics-panel(hidden role="tabpanel" aria-labelledby="demo-tab-stones")
            h2 Карта сегментів (SOM)
            p.account-help Технічна сегментація тільки ізольованого synthetic dataset. Це не прогноз, не оцінка, не ринкова чи інвестиційна аналітика.
            p.demo-scope__notice(role="note")
                strong DEMO · SYNTHETIC SOM
                |  Провайдерні значення проходять демонстраційний policy scenario на рівні окремої ознаки. Заборонені значення не входять до вектора.
            form#demo-som-report-search.demo-som-search(role="search")
                label(for="demo-som-report-id") Звіт для аналізу
                input#demo-som-report-id.form-control(type="search" placeholder="Наприклад, DEMO-00999" autocomplete="off")
                button.btn.btn-primary(type="submit") Показати на карті
            #demo-som-status.dashboard-status(role="status" aria-live="polite")
            #demo-som-results(aria-live="polite")
        dialog#demo-workflow-actor-dialog.account-dialog(aria-labelledby="demo-workflow-actor-dialog-title")
            form(method="dialog")
                .account-dialog__header
                    h2#demo-workflow-actor-dialog-title Деталі synthetic actor
                    button.account-dialog__close(type="submit" aria-label="Закрити") ×
                #demo-workflow-actor-dialog-content
        dialog#demo-provider-dialog.account-dialog(aria-labelledby="demo-provider-dialog-title")
            form(method="dialog")
                .account-dialog__header
                    h2#demo-provider-dialog-title Деталі джерела
                    button.account-dialog__close(type="submit" aria-label="Закрити") ×
                #demo-provider-dialog-content
