extends ../layout/main

block content
    .dashboard-page(hidden data-protected-page="true" data-dashboard)
        .page-header
            div
                h1.page-title Всі звіти
                p.page-subtitle Робочий список експертних звітів
            a#create-report-action.btn.btn-primary(href="/create-report.html") Новий звіт

        form#dashboard-filters.filters-container
            .filters-bar
                .search-group
                    label.sr-only(for="report-search") Пошук за номером звіту
                    input#report-search(type="search" name="search" placeholder="Пошук за номером звіту" autocomplete="off")
                .filter-control
                    label(for="report-status") Стан звіту
                    select#report-status.form-select(name="report_status")
                        option(value="") Усі стани
                        option(value="draft") Чернетка
                        option(value="review") На перевірці
                        option(value="issued") Видано
                        option(value="void") Анульовано
                .filter-control
                    label(for="market-status") Ринковий стан
                    select#market-status.form-select(name="market_status")
                        option(value="") Усі
                        option(value="not_for_sale") Не продається
                        option(value="available") Доступний
                        option(value="reserved") Зарезервовано
                        option(value="sold") Продано
                        option(value="withdrawn") Знято з продажу
                .filter-control
                    label(for="report-sort") Сортування
                    select#report-sort.form-select(name="sort")
                        option(value="report_date_desc") Спочатку нові
                        option(value="report_date_asc") Спочатку старі
                        option(value="report_id_asc") Номер: за зростанням
                        option(value="report_id_desc") Номер: за спаданням
                        option(value="carat_desc") Вага: від більшої
                        option(value="carat_asc") Вага: від меншої
                #expert-filter-wrap.filter-control(hidden)
                    label(for="expert-filter") Експерт
                    select#expert-filter.form-select(name="expert_id")
                        option(value="") Усі експерти
            .filter-actions
                button.btn.btn-primary(type="submit") Застосувати
                button.btn.btn-outline(type="reset") Очистити

        #dashboard-status.dashboard-status(role="status" aria-live="polite")

        .table-container(tabindex="0")
            table.data-table
                thead
                    tr
                        th ID звіту
                        th Дата
                        th Форма
                        th Вага
                        th Походження
                        th Стан звіту
                        th Ринковий стан
                        th Дії
                tbody

        nav.pagination(aria-label="Пагінація звітів")
