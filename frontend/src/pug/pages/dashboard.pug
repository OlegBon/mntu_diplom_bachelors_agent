extends ../layout/main

block content
    .dashboard-page(hidden data-protected-page="true" data-dashboard)
        .page-header
            div
                h1.page-title Всі звіти
                p.page-subtitle Управління сертифікатами та оцінками.
            a#create-report-action.btn.btn-primary(href="/create-report.html") Новий звіт

        .filters-container
            .filters-bar
                .search-group
                    label.sr-only(for="report-search") Пошук за номером звіту
                    input#report-search(type="search" placeholder="Пошук за номером звіту" autocomplete="off")
                button#toggle-filters.btn.btn-primary(type="button" aria-expanded="false" aria-controls="advanced-filters") Фільтри
                .filter-control.filter-control--quick
                    label.sr-only(for="quick-report-status") Статус звіту
                    select#quick-report-status.form-select
                        option(value="") Усі статуси звіту
                        option(value="draft") Чернетка
                        option(value="review") На перевірці
                        option(value="issued") Видано
                        option(value="void") Анульовано
                .filter-control.filter-control--quick
                    label.sr-only(for="quick-market-status") Статус продажу
                    select#quick-market-status.form-select
                        option(value="") Усі статуси продажу
                        option(value="false") Не продано
                        option(value="true") Продано
                #expert-filter-wrap.filter-control.filter-control--quick(hidden)
                    label.sr-only(for="expert-filter") Експерт
                    select#expert-filter.form-select
                        option(value="") Усі експерти

            #advanced-filters.advanced-filters
                form#dashboard-filters.filters-grid
                    .filter-item
                        label(for="shape-filter") Форма (Shape)
                        select#shape-filter.form-select(name="shape")
                            option(value="") Будь-яка
                            option(value="Round") Round
                            option(value="Princess") Princess
                            option(value="Oval") Oval
                            option(value="Emerald") Emerald
                            option(value="Cushion") Cushion
                            option(value="Radiant") Radiant
                            option(value="Pear") Pear
                            option(value="Heart") Heart
                            option(value="Marquise") Marquise
                            option(value="Asscher") Asscher
                    .filter-item
                        label Вага (Carat)
                        .range-inputs
                            input#carat-min.form-control(type="number" name="carat_min" min="0" step="0.01" placeholder="Від")
                            input#carat-max.form-control(type="number" name="carat_max" min="0" step="0.01" placeholder="До")
                    .filter-item
                        label(for="color-filter") Колір (Color)
                        select#color-filter.form-select(name="color_grade")
                            option(value="") Будь-який
                    .filter-item
                        label(for="clarity-filter") Чистота (Clarity)
                        select#clarity-filter.form-select(name="clarity_grade")
                            option(value="") Будь-яка
                    .filter-item
                        label(for="cut-filter") Якість (Cut)
                        select#cut-filter.form-select(name="cut_grade")
                            option(value="") Будь-яка
                    .filter-item
                        label Довідковий орієнтир (USD)
                        .range-inputs
                            input#price-min.form-control(type="number" name="price_min" min="0" step="0.01" placeholder="Від")
                            input#price-max.form-control(type="number" name="price_max" min="0" step="0.01" placeholder="До")
                    .filter-item
                        label(for="date-from") Дата створення: від
                        input#date-from.form-control(type="date" name="date_from")
                    .filter-item
                        label(for="date-to") Дата створення: до
                        input#date-to.form-control(type="date" name="date_to")
                    .filter-actions
                        button.btn.btn-primary.btn-sm(type="submit") Застосувати
                        button.btn.btn-outline.btn-sm(type="reset") Очистити

        #dashboard-status.dashboard-status(role="status" aria-live="polite")
        p#dashboard-demo-note.dashboard-demo-note
            | Довідкові орієнтири (USD) формуються для нових або змінених чернеток за налаштованим провайдером (поточне джерело — OpenFacet). Позначка SYS означає Системний довідковий орієнтир, ADM — орієнтир, застосовність якого підтвердив адміністратор; поруч завжди вказано джерело. Це не експертна, продажна чи транзакційна ціна; еквівалент у UAH додається лише за увімкненим курсом НБУ та фіксується під час створення.

        .table-container(tabindex="0")
            table.data-table
                thead
                    tr
                        th
                            button.table-sort(type="button" data-sort-key="report_id" aria-label="Сортувати за ID звіту") ID звіту
                        th
                            button.table-sort(type="button" data-sort-key="report_date" aria-label="Сортувати за датою") Дата
                        th
                            button.table-sort(type="button" data-sort-key="shape" aria-label="Сортувати за формою") Форма
                        th
                            button.table-sort(type="button" data-sort-key="carat" aria-label="Сортувати за вагою") Вага (ct)
                        th
                            button.table-sort(type="button" data-sort-key="color" aria-label="Сортувати за кольором") Колір
                        th
                            button.table-sort(type="button" data-sort-key="clarity" aria-label="Сортувати за чистотою") Чистота
                        th
                            button.table-sort(type="button" data-sort-key="cut" aria-label="Сортувати за Cut") Cut
                        th
                            button.table-sort(type="button" data-sort-key="price" aria-label="Сортувати за довідковим орієнтиром") Ціна (USD)
                        th
                            button.table-sort(type="button" data-sort-key="report_status" aria-label="Сортувати за статусом звіту") Статус звіту
                        th
                            button.table-sort(type="button" data-sort-key="market_status" aria-label="Сортувати за статусом продажу") Статус продажу
                        th Дії
                tbody

        nav.pagination(aria-label="Пагінація звітів")
