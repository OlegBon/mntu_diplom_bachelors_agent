extends ../layout/main

block content
    .login-container
        .login-card
            h2 Вхід у систему
            p.text-muted Будь ласка, авторизуйтесь
            
            // Форма
            form#login-form
                .form-group
                    label(for="username") Логін
                    input#username.form-control(type="text" name="username" required autocomplete="username" placeholder="admin")
                
                .form-group
                    label(for="password") Пароль
                    input#password.form-control(type="password" name="password" required autocomplete="current-password" placeholder="******")
                
                // Місце для помилки
                p#error-msg(style="color: red; display: none;")
                
                button.btn.btn-primary(type="submit") Увійти
