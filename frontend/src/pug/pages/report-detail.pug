extends ../layout/main

block content
    main.report-detail-page(hidden data-protected-page="true" data-report-detail)
        .page-header
            div
                p.report-detail__eyebrow(data-i18n="detail.privateReport") Private report
                h1#report-detail-title(data-i18n="detail.loadingReport") Loading report…
                p#report-detail-subtitle.page-subtitle(data-i18n="detail.subtitle") Data, expert conclusion, attachments, and change history.
            a.btn.btn-outline(href="/dashboard.html" data-i18n="detail.backToReports") Back to all reports

        p#report-detail-status.form-status(role="status" aria-live="polite" hidden)

        .report-detail__grid
            form#report-detail-form.report-detail__surface(novalidate)
                .report-detail__section
                    h2(data-i18n="wizard.step1") 1. Identification and 4C
                    .form-row
                        .form-group.half
                            label(for="detail-examination-date" data-i18n="wizard.examinationDate") Examination / assessment date
                            input#detail-examination-date.form-control(type="date" name="examination_date" required)
                        .form-group.half
                            label(for="detail-shape" data-i18n="wizard.shape") Shape
                            input#detail-shape.form-control(type="text" name="shape" maxlength="50" required)
                    .form-row
                        .form-group.half
                            label(for="detail-carat" data-i18n="wizard.caratWeight") Carat weight
                            input#detail-carat.form-control(type="number" name="carat_weight" min="0.01" max="100" step="0.01" required)
                        .form-group.half
                            label(for="detail-market-status") Комерційний стан
                            select#detail-market-status.form-select(name="market_status" required)
                                option(value="not_for_sale") Не виставлено на продаж
                                option(value="available") Доступний
                                option(value="reserved") Зарезервований
                                option(value="sold") Продано
                                option(value="withdrawn") Знято з продажу
                    .form-row.three-cols
                        .form-group
                            label(for="detail-color" data-i18n="wizard.color") Color
                            select#detail-color.form-select(name="color_grade" required)
                                option(value="") Оберіть колір
                        .form-group
                            label(for="detail-clarity" data-i18n="wizard.clarity") Clarity
                            select#detail-clarity.form-select(name="clarity_grade" required)
                                option(value="") Оберіть чистоту
                        .form-group
                            label(for="detail-fluorescence") Fluоресценція
                            select#detail-fluorescence.form-select(name="fluorescence_grade" required)
                                option(value="") Оберіть значення

                .report-detail__section
                    h2(data-i18n="wizard.step2") 2. Geometry (IDC)
                    .form-row.three-cols
                        .form-group
                            label(for="detail-length" data-i18n="wizard.length") Length (mm)
                            input#detail-length.form-control(type="number" name="measurements_length" min="0.01" max="999" step="0.01" required)
                        .form-group
                            label(for="detail-width" data-i18n="wizard.width") Width (mm)
                            input#detail-width.form-control(type="number" name="measurements_width" min="0.01" max="999" step="0.01" required)
                        .form-group
                            label(for="detail-depth-mm" data-i18n="wizard.depth") Depth (mm)
                            input#detail-depth-mm.form-control(type="number" name="measurements_depth" min="0.01" max="999" step="0.01" required)
                    .form-row
                        .form-group.half
                            label(for="detail-table") Table (%)
                            input#detail-table.form-control(type="number" name="table_percent" min="0.1" max="100" step="0.1" required)
                        .form-group.half
                            label(for="detail-depth-percent") Total Depth (%)
                            input#detail-depth-percent.form-control(type="number" name="depth_percent" min="0.1" max="100" step="0.1" required)
                    .form-row
                        .form-group.half
                            label(for="detail-crown") Crown Angle (°)
                            input#detail-crown.form-control(type="number" name="crown_angle" min="0.1" max="90" step="0.1" required)
                        .form-group.half
                            label(for="detail-pavilion") Pavilion Angle (°)
                            input#detail-pavilion.form-control(type="number" name="pavilion_angle" min="0.1" max="90" step="0.1" required)
                    .form-row
                        .form-group.half
                            label(for="detail-girdle") Girdle Thickness
                            select#detail-girdle.form-select(name="girdle_thickness")
                                option(value="") Не задано
                        .form-group.half
                            label(for="detail-culet") Culet Size
                            select#detail-culet.form-select(name="culet_size")
                                option(value="") Не задано

                .report-detail__section
                    h2(data-i18n="wizard.step3") 3. Conclusion and media
                    .form-row
                        .form-group.half
                            label(for="detail-origin" data-i18n="wizard.origin") Origin
                            select#detail-origin.form-select(name="origin" required)
                                option(value="unknown") Не визначено
                                option(value="natural") Природний
                                option(value="lab_grown") Лабораторно вирощений
                                option(value="other") Інше
                        .form-group.half
                            label(for="detail-treatment" data-i18n="wizard.treatment") Treatment indication
                            select#detail-treatment.form-select(name="treatment_status" required)
                                option(value="not_assessed") Не оцінено
                                option(value="none_detected") Не виявлено
                                option(value="disclosed") Заявлено
                                option(value="confirmed") Підтверджено
                    .form-row
                        .form-group.half
                            label(for="detail-identification-status" data-i18n="wizard.identificationStatus") Identification confidence
                            select#detail-identification-status.form-select(name="identification_status" required)
                                option(value="preliminary") Попередній
                                option(value="confirmed") Підтверджено
                                option(value="inconclusive") Невизначено
                        .form-group.half
                            label(for="detail-method" data-i18n="wizard.identificationMethod") Identification method
                            input#detail-method.form-control(type="text" name="identification_method" maxlength="255")
                    .form-group
                        label(for="detail-conclusion" data-i18n="wizard.identificationConclusion") Identification conclusion
                        textarea#detail-conclusion.form-control(name="identification_conclusion" rows="3")
                    .form-group
                        label(for="detail-comment" data-i18n="wizard.expertComment") Expert comment
                        textarea#detail-comment.form-control(name="expert_comment" rows="3")
                    .form-row
                        .form-group.half
                            label(for="detail-polish") Polish
                            select#detail-polish.form-select(name="polish_grade" required)
                                option(value="") Оберіть оцінку
                        .form-group.half
                            label(for="detail-symmetry") Symmetry
                            select#detail-symmetry.form-select(name="symmetry_grade" required)
                                option(value="") Оберіть оцінку
                    .form-row
                        .form-group.half
                            label(for="detail-expert-proportions") Експертна оцінка Proportions
                            select#detail-expert-proportions.form-select(name="expert_proportions_grade")
                                option(value="") Не задано
                        .form-group.half
                            label(for="detail-expert-cut-result") Підсумковий Cut за експертними оцінками
                            input#detail-expert-cut-result.form-control(type="text" readonly aria-readonly="true" value="—")
                    p.report-detail__help Polish і Symmetry — прямі оцінки експерта. Система обчислює підсумковий Cut із них та експертної оцінки Proportions; для видачі потрібен Proportions.
                .report-detail__actions
                    button#detail-edit.btn.btn-outline(type="button" data-i18n="detail.editDraft") Edit draft
                    button#detail-save.btn.btn-primary(type="submit" hidden data-i18n="detail.saveChanges") Save changes
                    button#detail-cancel.btn.btn-outline(type="button" hidden data-i18n="wizard.cancel") Cancel

            aside.report-detail__side
                section.report-detail__surface
                    h2(data-i18n="detail.reportState") Report state
                    p#detail-status-badge.report-detail__status-badge —
                    p#detail-system-summary.report-detail__help Системний IDC: —
                    p#detail-expert-summary.report-detail__help Експертне підтвердження: —
                    .form-group.report-detail__transition-reason
                        label(for="detail-transition-reason" data-i18n="detail.transitionReason") Status-change comment
                        textarea#detail-transition-reason.form-control(rows="2" maxlength="2000" placeholder="Optional, but recommended when returning or voiding" data-i18n-placeholder="detail.transitionReasonPlaceholder")
                    .report-detail__transition-actions#detail-transitions
                    p#detail-transition-help.report-detail__help
                section.report-detail__surface
                    h2(data-i18n="detail.narrativeQuality") Text-field check
                    p.report-detail__help(data-i18n="detail.narrativeHelp") Automated completion signals do not assess the professional conclusion and do not block saving.
                    ul#detail-narrative-quality.report-detail__list
                        li(data-i18n="detail.loading") Loading…
                section.report-detail__surface
                    h2(data-i18n="detail.marketReference") Market reference value
                    p#detail-valuations-help.report-detail__help(data-i18n="detail.marketReferenceHelp") A market reference is not an expert, sale, or transaction price.
                    ul#detail-valuations.report-detail__list
                        li(data-i18n="detail.loading") Loading…
                section.report-detail__surface
                    h2(data-i18n="detail.attachments") Attachments
                    ul#detail-media.report-detail__list
                        li(data-i18n="detail.loading") Loading…
                section#detail-passport.report-detail__surface(hidden)
                    h2(data-i18n="detail.publicPassport") Public passport
                    p#detail-passport-state.report-detail__help(data-i18n="detail.passportIssuedOnly") Available only for an issued report.
                    p#detail-passport-code.report-detail__passport-code(hidden)
                        span(data-i18n="detail.passportCode") Passport code
                        code
                    a#detail-passport-link(href="#" target="_blank" rel="noopener noreferrer" hidden data-i18n="detail.openPublicPassport") Open public passport
                    img#detail-passport-qr.report-detail__qr(alt="Public passport QR code" data-i18n-alt="detail.passportQrAlt" hidden)
                    .report-detail__transition-actions
                        button#detail-passport-publish.btn.btn-primary(type="button" hidden data-i18n="detail.publishPassport") Publish passport
                        button#detail-passport-copy-link.btn.btn-outline(type="button" hidden data-i18n="detail.copyLink") Copy link
                        button#detail-passport-copy-code.btn.btn-outline(type="button" hidden data-i18n="detail.copyCode") Copy code
                        button#detail-passport-pdf.btn.btn-primary(type="button" hidden data-i18n="detail.downloadPdf") Download PDF
                        button#detail-passport-reissue.btn.btn-outline(type="button" hidden data-i18n="detail.reissueLink") Reissue link
                        button#detail-passport-revoke.btn.btn-outline(type="button" hidden data-i18n="detail.revokePublication") Revoke publication
                section.report-detail__surface
                    h2(data-i18n="detail.history") Change history
                    ol#detail-events.report-detail__timeline
                        li(data-i18n="detail.loading") Loading…
        dialog#media-publication-dialog.account-dialog(aria-labelledby="media-publication-dialog-title")
            form#media-publication-form
                .account-dialog__header
                    h2#media-publication-dialog-title(data-i18n="detail.confirmAttachmentPublication") Confirm attachment publication
                    button#media-publication-dialog-close.account-dialog__close(type="button" aria-label="Close" data-i18n-aria-label="wizard.close") ×
                p#media-publication-description.account-help
                p#media-publication-status.form-status(role="status" aria-live="polite" hidden)
                .account-dialog__actions
                    button#media-publication-cancel.btn.btn-outline(type="button" data-i18n="wizard.cancel") Cancel
                    button#media-publication-submit.btn.btn-primary(type="submit" data-i18n="detail.confirm") Confirm
