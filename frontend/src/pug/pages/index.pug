extends ../layout/main

block content
    .public-home
        section.hero-section
            .hero-copy
                h1 Ідентифікація та оцінювання діамантів
                p Надійна перевірка паспортів та експертні звіти про діаманти — в одному робочому середовищі.
                .hero-actions
                    a.btn.btn-primary(href="#public-passport") Перевірити паспорт
                    a.text-action(href="/login.html") Увійти для роботи зі звітами
            img.hero-image(src="img/diamond-inspection-hero.png" alt="Діамант у гемологічному пінцеті" width="1792" height="896")

        section#public-passport.public-passport
            .passport-intro
                h2 Перевірка, якій можна довіряти
                p Введіть номер виданого звіту, щоб перейти до його публічного паспорта. Публічні дані будуть доступні лише після запуску відповідного функціоналу.
            form#public-search-form.passport-search
                label(for="search-input") Номер звіту
                .passport-search-controls
                    input#search-input(type="search" placeholder="Наприклад, DR-00321" required autocomplete="off")
                    button.btn.btn-primary(type="submit") Перевірити

        section.public-principles(aria-label="Можливості Diamant ID")
            article
                h2 Експертні звіти
                p Послідовна фіксація характеристик каменю та результатів оцінювання.
            article
                h2 Контроль даних
                p Чітке розмежування експертного висновку й розрахункового результату системи.
            article
                h2 Перевірка паспорта
                p Окремий публічний маршрут для виданих звітів — після реалізації паспорта й QR.
