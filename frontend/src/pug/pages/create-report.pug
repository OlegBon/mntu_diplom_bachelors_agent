extends ../layout/main

block content
    .create-report-page(hidden data-protected-page="true")
        .page-header
            h1 Новий звіт
            p.text-muted Створення чернетки експертного звіту про камінь

        .report-grid
            .form-column
                .stepper-tabs(role="tablist" aria-label="Кроки створення звіту")
                    button.tab.active(type="button" data-step="1" role="tab" aria-selected="true")
                        span.mobile-text 1. Основне
                        span.desktop-text 1. Ідентифікація та 4C
                    button.tab(type="button" data-step="2" role="tab" aria-selected="false")
                        span.mobile-text 2. Геометрія
                        span.desktop-text 2. Геометрія (IDC)
                    button.tab(type="button" data-step="3" role="tab" aria-selected="false")
                        span.mobile-text 3. Висновок
                        span.desktop-text 3. Висновок та медіа

                form#wizard-form(novalidate)
                    p#wizard-status.form-status(role="status" aria-live="polite" hidden)

                    .step-content.active(data-step="1" role="tabpanel")
                        h3 Ідентифікація
                        .form-group
                            label(for="report-id-preview") Наступний номер звіту
                            input#report-id-preview.form-control.bg-light(type="text" value="Завантаження…" disabled aria-describedby="report-id-help")
                            small#report-id-help.form-help Номер остаточно присвоюється сервером під час збереження.
                        .form-row
                            .form-group.half
                                label(for="examination-date") Дата дослідження / оцінки
                                input#examination-date.form-control(type="date" name="examination_date" required)
                            .form-group.half
                                label(for="shape") Форма (Shape)
                                select#shape.form-select(data-reference-category="shape" name="shape" required disabled)
                                    option(value="") Завантаження довідника…
                        .form-group
                            label(for="origin") Походження (Origin)
                            select#origin.form-select(data-reference-category="origin" name="origin" required disabled)
                                option(value="") Завантаження довідника…

                        h3 Характеристики 4C
                        .form-group
                            label(for="carat-weight") Вага (Carat Weight)
                            input#carat-weight.form-control(type="number" step="0.01" min="0.01" max="100" name="carat_weight" placeholder="ct" required)
                        .form-row
                            .form-group.half
                                label(for="color-grade") Колір (Color)
                                select#color-grade.form-select(data-grade-category="color" name="color_grade" required disabled)
                                    option(value="") Завантаження довідника…
                            .form-group.half
                                label(for="clarity-grade") Чистота (Clarity)
                                select#clarity-grade.form-select(data-grade-category="clarity" name="clarity_grade" required disabled)
                                    option(value="") Завантаження довідника…

                    .step-content(data-step="2" role="tabpanel" hidden)
                        h3 Розміри (Dimensions)
                        .form-row.three-cols
                            .form-group
                                label(for="measurements-length") Довжина (mm)
                                input#measurements-length.form-control(type="number" step="0.01" min="0.01" name="measurements_length" placeholder="min. 0,01" required)
                            .form-group
                                label(for="measurements-width") Ширина (mm)
                                input#measurements-width.form-control(type="number" step="0.01" min="0.01" name="measurements_width" placeholder="max. 0,01" required)
                            .form-group
                                label(for="measurements-depth") Висота (mm)
                                input#measurements-depth.form-control(type="number" step="0.01" min="0.01" name="measurements_depth" placeholder="depth" required)

                        h3 Параметри огранювання (IDC)
                        .form-row
                            .form-group.half
                                label(for="table-percent") Table (%)
                                input#table-percent.form-control(type="number" step="0.1" min="0.1" max="100" name="table_percent" placeholder="57,0" required)
                            .form-group.half
                                label(for="depth-percent") Total Depth (%)
                                input#depth-percent.form-control(type="number" step="0.1" min="0.1" max="100" name="depth_percent" placeholder="61,5" required)
                        .form-row
                            .form-group.half
                                label(for="crown-angle") Crown Angle (°)
                                input#crown-angle.form-control(type="number" step="0.1" min="0.1" max="90" name="crown_angle" placeholder="34,5" required)
                            .form-group.half
                                label(for="pavilion-angle") Pavilion Angle (°)
                                input#pavilion-angle.form-control(type="number" step="0.1" min="0.1" max="90" name="pavilion_angle" placeholder="40,8" required)
                        .form-row
                            .form-group.half
                                label(for="girdle-thickness") Girdle Thickness
                                select#girdle-thickness.form-select(data-reference-category="girdle_thickness" name="girdle_thickness" disabled)
                                    option(value="") Не зазначено
                            .form-group.half
                                label(for="culet-size") Culet Size
                                select#culet-size.form-select(data-reference-category="culet_size" name="culet_size" disabled)
                                    option(value="") Не зазначено

                    .step-content(data-step="3" role="tabpanel" hidden)
                        h3 Якість обробки (Finish)
                        .form-row
                            .form-group.half
                                label(for="polish-grade") Polish (Поліровка)
                                select#polish-grade.form-select(data-grade-category="polish" name="polish_grade" required disabled)
                                    option(value="") Завантаження довідника…
                            .form-group.half
                                label(for="symmetry-grade") Symmetry (Симетрія)
                                select#symmetry-grade.form-select(data-grade-category="symmetry" name="symmetry_grade" required disabled)
                                    option(value="") Завантаження довідника…
                        .form-group
                            label(for="fluorescence-grade") Fluorescence (Флуоресценція)
                            select#fluorescence-grade.form-select(data-grade-category="fluorescence" name="fluorescence_grade" required disabled)
                                option(value="") Завантаження довідника…

                        h3 Висновок експерта
                        .form-row
                            .form-group.half
                                label(for="treatment-status") Ознаки обробки
                                select#treatment-status.form-select(data-reference-category="treatment_status" name="treatment_status" required disabled)
                                    option(value="") Завантаження довідника…
                            .form-group.half
                                label(for="identification-status") Рівень підтвердження
                                select#identification-status.form-select(data-reference-category="identification_status" name="identification_status" required disabled)
                                    option(value="") Завантаження довідника…
                        .form-group
                            label(for="identification-method") Метод ідентифікації
                            input#identification-method.form-control(type="text" name="identification_method" maxlength="255" placeholder="Наприклад, гемологічна експертиза")
                        .form-group
                            label(for="identification-conclusion") Висновок щодо ідентифікації
                            textarea#identification-conclusion.form-control(name="identification_conclusion" rows="3")
                        .form-group
                            label(for="expert-comment") Коментар експерта
                            textarea#expert-comment.form-control(name="expert_comment" rows="3" placeholder="Спостереження, включення та особливості каменю")

                        h3 Медіа
                        p.text-muted Комерційний стан не задається під час створення: нова чернетка має стан «Не виставлено на продаж». Змінити його можна буде у перегляді та редагуванні звіту.
                        .form-row
                            .form-group.half
                                label(for="plotting-image") Схема дефектів (Plotting)
                                .media-upload-card
                                    img#plotting-preview.media-upload-preview(src="/img/plotting-placeholder.svg" alt="Схема дефектів не додана" width="320" height="180")
                                    input#plotting-image.file-input(type="file" name="plotting_image" accept="image/jpeg,image/png,image/webp")
                                    label.btn.btn-outline.file-picker(for="plotting-image") Вибрати файл
                                    span.file-name(data-file-name-for="plotting-image") Файл не вибрано
                                    small.media-upload-help JPEG, PNG або WebP, до 10 MB. Зберігається приватно.
                            .form-group.half
                                label(for="real-image") Фото каменя
                                .media-upload-card
                                    img#stone-preview.media-upload-preview(src="/img/stone-placeholder.svg" alt="Фото каменя не додано" width="320" height="180")
                                    input#real-image.file-input(type="file" name="real_image" accept="image/jpeg,image/png,image/webp")
                                    label.btn.btn-outline.file-picker(for="real-image") Вибрати файл
                                    span.file-name(data-file-name-for="real-image") Файл не вибрано
                                    small.media-upload-help JPEG, PNG або WebP, до 10 MB. Зберігається приватно.

                    .wizard-actions
                        button#prev-btn.btn.btn-outline(type="button" disabled) Назад
                        button#save-btn.btn.btn-primary(type="submit" hidden) Зберегти чернетку
                        button#next-btn.btn.btn-primary(type="button") Далі

            .calc-column
                .calc-card
                    h3 Системний preview IDC
                    p.text-muted Розрахунок виконується сервером за введеними параметрами. Це не експертне підтвердження та не оцінка вартості.
                    hr
                    .calc-group
                        label Proportions
                        .calc-value.placeholder#res-prop --
                    .calc-group
                        label Polish
                        .calc-value.placeholder#res-pol --
                    .calc-group
                        label Symmetry
                        .calc-value.placeholder#res-sym --
                    .calc-group.highlight
                        label Final Cut Grade
                        .calc-value.placeholder#res-final --
                    hr
                    h4 Прогнозована ціна
                    .calc-group.forecast
                        label Системний прогноз (USD)
                        .calc-value.placeholder
                            span#res-price --
                            sup#price-demo-marker.demo-marker(hidden) d
                    p.text-muted.calc-demo-note#price-demo-note d — демонстраційний прогноз, не ринкова, експертна або продажна ціна.
                    p.text-muted#calculation-rule-version Правило буде показано після введення параметрів огранювання.
